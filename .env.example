# --- Genel ---
APP_ENV=development
APP_NAME=Hallederiz
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=hallederiz
POSTGRES_PASSWORD=hallederiz_dev
POSTGRES_DB=hallederiz
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3 uyumlu dosya depolama) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=hallederiz
S3_SECRET_KEY=hallederiz_dev_secret
S3_BUCKET=hallederiz-uploads

# --- Güvenlik ---
# Üretimde mutlaka uzun ve rastgele bir değerle değiştir:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- AI ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS (virgülle ayrılmış) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
